-- Body collision management
spawn(function()
    while task.wait() do
        pcall(function()
            local char = getChar()
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            if y then
                if not hrp:FindFirstChild("BodyClip") then
                    local Yv = Instance.new("BodyVelocity")
                    Yv.Name = "BodyClip"; Yv.Parent = hrp
                    Yv.MaxForce = Vector3.new(1e5,1e5,1e5); Yv.Velocity = Vector3.new(0,0,0)
                end
                if not char:FindFirstChild("highlight") then
                    local Yv = Instance.new("Highlight")
                    Yv.Name = "highlight"; Yv.Enabled = true
                    Yv.FillColor = Color3.fromRGB(0,255,255); Yv.OutlineColor = Color3.fromRGB(255,255,255)
                    Yv.FillTransparency = .5; Yv.OutlineTransparency = .2; Yv.Parent = char
                end
                for _, dv in pairs(char:GetDescendants()) do
                    if dv:IsA("BasePart") then dv.CanCollide = false end
                end
            else
                y = false
                if hrp:FindFirstChild("BodyClip") then
                    hrp:FindFirstChild("BodyClip"):Destroy()
                end
                if char:FindFirstChild("highlight") then
                    char:FindFirstChild("highlight"):Destroy()
                end
            end
        end)
    end
end)

-- Teleport functions
_tp = function(Y)
    local ch = getChar()
    if not ch or not ch:FindFirstChild("HumanoidRootPart") then return end
    local Q  = ch.HumanoidRootPart
    local mag = (Y.Position - Q.Position).Magnitude
    local ai  = TweenInfo.new(mag/300, Enum.EasingStyle.Linear)
    local tw  = TweenService:Create(J, ai, {CFrame = Y})
    if ch.Humanoid.Sit then
        J.CFrame = CFrame.new(J.Position.X, Y.Y, J.Position.Z)
    end
    tw:Play()
    task.spawn(function()
        while tw.PlaybackState == Enum.PlaybackState.Playing do
            if not y then tw:Cancel(); break end
            task.wait(.1)
        end
    end)
end

TeleportToTarget = function(Y) _tp(Y) end

notween = function(Y)
    local hrp = getHRP()
    if hrp then hrp.CFrame = Y end
end

function BTP(Y)
    local Pv = Players.LocalPlayer
    local Rv = Pv.Character.HumanoidRootPart
    local Qv = Pv.Character.Humanoid
    local rv = Pv.PlayerGui.Main
    local wv = Rv.Position
    repeat
        Qv.Health = 0; Rv.CFrame = Y; rv.Quest.Visible = false
        if (Rv.Position - wv).Magnitude > 1 then wv = Rv.Position; Rv.CFrame = Y end
        task.wait(.5)
    until (Y.Position - Rv.Position).Magnitude <= 2000
end

